# Public browser-safe Supabase credentials. Never place a service-role key in CRA.
REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_ANON_KEY=

# Browser-safe Stripe key. Checkout sessions are still created only by the server.
REACT_APP_STRIPE_PUBLISHABLE_KEY=

# Optional local-development override. Only honored by development builds.
# REACT_APP_ENTITLEMENT_MODE=development

# Server-side only. Configure in Vercel; never prefix these with REACT_APP_ and never commit real values.
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SUITE_TRIAL_DAYS=14
