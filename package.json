{
  "name": "sixsigma-pro",
  "version": "1.0.0",
  "private": true,
  "dependencies": {
    "@supabase/supabase-js": "^2.57.4",
    "html2canvas": "^1.4.1",
    "jspdf": "^2.5.1",
    "mathjs": "^12.4.0",
    "papaparse": "^5.4.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-dropzone": "^14.2.3",
    "react-router-dom": "^6.22.0",
    "react-scripts": "5.0.1",
    "recharts": "^2.12.0",
    "stripe": "^18.5.0"
  },
  "scripts": {
    "prestart": "node scripts/validate-supabase-target.js development",
    "start": "react-scripts start",
    "prebuild": "node scripts/validate-supabase-target.js production",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "validate:statistics": "react-scripts test --watchAll=false --runTestsByPath src/foundation/statisticalValidationReport.test.js",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ]
  },
  "jest": {
    "moduleNameMapper": {
      "^!!raw-loader!(.*)$": "$1"
    },
    "transform": {
      "^.+\\.css$": "<rootDir>/scripts/jest/rawCssTransform.js"
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "raw-loader": "^4.0.2",
    "supabase": "^2.114.0"
  }
}
